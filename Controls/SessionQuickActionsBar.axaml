<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:controls="using:CxShell.Controls"
             xmlns:services="using:CxShell.Services"
             x:Class="CxShell.Controls.SessionQuickActionsBar"
             x:CompileBindings="False"
             HorizontalAlignment="Right"
             VerticalAlignment="Bottom"
             Margin="0,0,16,48">
    <UserControl.Styles>
        <Style Selector="Border#QuickActionPill">
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#QuickActionPill:pointerover">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Border#QuickActionGrip">
            <Setter Property="Cursor" Value="SizeAll"/>
            <Setter Property="Padding" Value="3,2,2,2"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border#QuickActionGrip atom|IconPresenter">
            <Setter Property="IconBrush" Value="#66FFFFFF"/>
        </Style>
        <Style Selector="Border#QuickActionGrip:pointerover atom|IconPresenter">
            <Setter Property="IconBrush" Value="#CCFFFFFF"/>
        </Style>
        <!-- The bar floats over the remote frame, so the buttons carry their own
             colours instead of the theme's light surface ones. -->
        <Style Selector="atom|Button.quick-action">
            <Setter Property="Foreground" Value="#FFF2F5F9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinHeight" Value="24"/>
        </Style>
        <Style Selector="atom|Button.quick-action:pointerover">
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
        </Style>
        <Style Selector="atom|Button.quick-dismiss">
            <Setter Property="Foreground" Value="#B3FFFFFF"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="MinHeight" Value="22"/>
        </Style>
        <Style Selector="atom|Button.quick-dismiss:pointerover">
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
        </Style>
    </UserControl.Styles>

    <Border x:Name="QuickActionPill"
            IsVisible="False"
            Background="#E01B1F24"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="8"
            Padding="4,3"
            DoubleTapped="OnPillDoubleTapped"
            BoxShadow="0 4 14 0 #59000000">
        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <!-- The whole pill is draggable; this handle is only the visual cue
                 for it, the drag itself is picked up on the pill background. -->
            <Border x:Name="QuickActionGrip"
                    atom:ToolTip.Tip="{Binding [SessionQuickActions.Drag], Source={x:Static services:LocalizationService.Shared}}"
                    atom:ToolTip.Placement="Top">
                <atom:IconPresenter Icon="{antdicons:AntDesignIconProvider Kind=HolderOutlined}"
                                    Width="12"
                                    Height="12"/>
            </Border>
            <StackPanel x:Name="RdpActions" Orientation="Horizontal" Spacing="2" IsVisible="False">
                <atom:Button x:Name="KeyboardCombinationsButton"
                             Classes="quick-action"
                             ButtonType="Text"
                             Content="{Binding [Rdp.Keyboard.Combinations], Source={x:Static services:LocalizationService.Shared}}"
                             Click="OnKeyboardCombinationsClick"/>
                <atom:Button x:Name="RdpCtrlAltDelButton"
                             Classes="quick-action"
                             ButtonType="Text"
                             Content="Ctrl+Alt+Del"
                             Click="OnRdpCtrlAltDelClick"/>
            </StackPanel>
            <StackPanel x:Name="VncActions" Orientation="Horizontal" Spacing="2" IsVisible="False">
                <atom:Button x:Name="VncClipboardButton"
                             Classes="quick-action"
                             ButtonType="Text"
                             Content="{Binding [SessionQuickActions.SendClipboard], Source={x:Static services:LocalizationService.Shared}}"
                             Click="OnVncClipboardClick"/>
                <atom:Button x:Name="VncCtrlAltDelButton"
                             Classes="quick-action"
                             ButtonType="Text"
                             Content="Ctrl+Alt+Del"
                             Click="OnVncCtrlAltDelClick"/>
            </StackPanel>
            <Border Width="1" Height="14" Margin="2,0"
                    VerticalAlignment="Center"
                    Background="#33FFFFFF"/>
            <atom:Button x:Name="DismissButton"
                         Classes="quick-dismiss"
                         ButtonType="Text"
                         Icon="{antdicons:AntDesignIconProvider Kind=CloseOutlined}"
                         atom:ToolTip.Tip="{Binding [SessionQuickActions.Hide], Source={x:Static services:LocalizationService.Shared}}"
                         atom:ToolTip.Placement="Top"
                         Click="OnDismissClick"/>
        </StackPanel>
    </Border>
</UserControl>
