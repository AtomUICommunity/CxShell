<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             x:Class="CxShell.Views.ImportPasswordWindow"
             Width="440"
             SizeToContent="Height"
             CanResize="False"
             ShowInTaskbar="False"
             WindowStartupLocation="CenterOwner"
             Background="{atom:SharedTokenResource ColorBgLayout}">

    <Border Background="{atom:SharedTokenResource ColorBgContainer}"
            BorderBrush="{atom:SharedTokenResource ColorBorder}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="22">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <ContentControl Content="{antdicons:AntDesignIconProvider Kind=LockOutlined}"
                                Width="20"
                                Height="20"
                                Foreground="{atom:SharedTokenResource ColorPrimary}"/>
                <TextBlock x:Name="HeadingText"
                           Grid.Column="1"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{atom:SharedTokenResource ColorText}"/>
            </Grid>

            <StackPanel Grid.Row="1" Spacing="6">
                <TextBlock x:Name="MessageText"
                           TextWrapping="Wrap"
                           Foreground="{atom:SharedTokenResource ColorText}"/>
                <TextBlock x:Name="HintText"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Spacing="6">
                <atom:LineEdit x:Name="PasswordBox"
                               PasswordChar="*"
                               IsAllowClear="True"
                               IsEnableRevealButton="True"
                               KeyDown="OnPasswordKeyDown"/>
                <TextBlock x:Name="ErrorText"
                           IsVisible="False"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{atom:SharedTokenResource ColorError}"/>
            </StackPanel>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <atom:Button x:Name="CancelButton"
                             ButtonType="Default"
                             Click="OnCancelClick"/>
                <atom:Button x:Name="ConfirmButton"
                             ButtonType="Primary"
                             Click="OnConfirmClick"/>
            </StackPanel>
        </Grid>
    </Border>
</atom:Window>
