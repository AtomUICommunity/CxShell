<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:controls="using:CxShell.Controls"
             xmlns:views="using:CxShell.Views"
             x:Class="CxShell.Views.RdpMonitorWindow"
             Title="CxShell RDP Monitor"
             Icon="/Assets/CxShellLogo.png"
             MinWidth="480"
             MinHeight="320"
             IsFullScreenCaptionButtonVisible="True"
             FullScreenTitleBarMode="Hidden"
             Background="#111111">
    <atom:Window.RightAddOn>
        <StackPanel Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0">
            <!-- Icon-only: the caption row already carries a full screen button,
                 so the bar only needs the "keep the taskbar" presentation. The
                 glyph is a screen outline with a filled strip along its bottom
                 edge, which reads as a taskbar far better than a generic icon. -->
            <Button Width="28"
                    Height="24"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="4"
                    ToolTip.Tip="切换到无边框保留任务栏模式"
                    Click="OnEnterKeepTaskbarClick">
                <Panel Width="16"
                       Height="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    <Border Margin="0.5,1.5,0.5,1.5"
                            BorderThickness="1.2"
                            CornerRadius="2"
                            BorderBrush="{Binding $parent[Button].Foreground}"/>
                    <Rectangle Height="2.6"
                               Margin="3,0,3,3.2"
                               VerticalAlignment="Bottom"
                               RadiusX="0.7"
                               RadiusY="0.7"
                               Fill="{Binding $parent[Button].Foreground}"/>
                </Panel>
            </Button>
        </StackPanel>
    </atom:Window.RightAddOn>

    <Grid Background="#111111">
        <controls:RdpSliceSurface x:Name="SliceSurface"
                                  Focusable="True"
                                  DragDrop.AllowDrop="True"
                                  PointerMoved="OnSurfacePointerMoved"
                                  PointerPressed="OnSurfacePointerPressed"
                                  PointerReleased="OnSurfacePointerReleased"
                                  PointerWheelChanged="OnSurfacePointerWheelChanged"/>

        <!-- Shared full-screen connection bar -->
        <views:FullScreenConnectionBar x:Name="FloatingBar"
                                       ShowTaskbarModeButton="False"
                                       IsQualityVisible="False"
                                       ZIndex="100"/>
    </Grid>
</atom:Window>
