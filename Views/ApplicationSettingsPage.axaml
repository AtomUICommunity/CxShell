<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:vm="using:CxShell.ViewModels"
             x:Class="CxShell.Views.ApplicationSettingsPage"
             x:DataType="vm:ApplicationSettingsViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" Margin="0,2,12,8">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding StartupText}"
                           FontWeight="SemiBold"
                           Foreground="{atom:SharedTokenResource ColorText}"/>
                <Border Background="{atom:SharedTokenResource ColorBgLayout}"
                        BorderBrush="{atom:SharedTokenResource ColorSplit}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,10">
                    <atom:CheckBox Content="{Binding ShowSessionManagerOnStartupText}"
                                   IsChecked="{Binding ShowSessionManagerOnStartup, Mode=TwoWay}"/>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="{Binding AppearanceText}"
                           FontWeight="SemiBold"
                           Foreground="{atom:SharedTokenResource ColorText}"/>
                <Border Background="{atom:SharedTokenResource ColorBgLayout}"
                        BorderBrush="{atom:SharedTokenResource ColorSplit}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,10">
                    <StackPanel Spacing="8">
                        <atom:CheckBox Content="{Binding ShowTabBarText}"
                                       IsChecked="{Binding ShowTabBar, Mode=TwoWay}"/>
                        <atom:CheckBox Content="{Binding ShowSftpPanelText}"
                                       IsChecked="{Binding ShowSftpPanel, Mode=TwoWay}"/>
                        <atom:CheckBox Content="{Binding ShowMonitorPanelText}"
                                       IsChecked="{Binding ShowMonitorPanel, Mode=TwoWay}"/>
                        <atom:CheckBox Content="{Binding ShowAgentPanelText}"
                                       IsChecked="{Binding ShowAgentPanel, Mode=TwoWay}"/>
                        <atom:CheckBox Content="{Binding EnableCommandSuggestionsText}"
                                       IsChecked="{Binding EnableCommandSuggestions, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="{Binding BackgroundImageText}"
                           FontWeight="SemiBold"
                           Foreground="{atom:SharedTokenResource ColorText}"/>
                <Border Background="{atom:SharedTokenResource ColorBgLayout}"
                        BorderBrush="{atom:SharedTokenResource ColorSplit}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,10">
                    <StackPanel Spacing="9">
                        <TextBlock Text="{Binding BackgroundImageDescriptionText}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{atom:SharedTokenResource ColorTextTertiary}"/>
                        <Grid ColumnDefinitions="132,*,Auto" ColumnSpacing="10">
                            <TextBlock Text="{Binding BackgroundImageFileText}"
                                       VerticalAlignment="Center"
                                       Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                            <atom:TextBox Grid.Column="1"
                                          Text="{Binding BackgroundImagePath, Mode=TwoWay}"/>
                            <atom:Button Grid.Column="2"
                                         Content="..."
                                         MinWidth="48"
                                         HorizontalContentAlignment="Center"
                                         Click="OnBrowseBackgroundImageClick"/>
                        </Grid>
                        <Grid ColumnDefinitions="132,*" ColumnSpacing="10">
                            <TextBlock Text="{Binding BackgroundImagePositionText}"
                                       VerticalAlignment="Center"
                                       Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                            <atom:Select Grid.Column="1"
                                         OptionsSource="{Binding BackgroundImagePositionOptions}"
                                         SelectedOption="{Binding BackgroundImagePositionOption, Mode=TwoWay}"
                                         HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid ColumnDefinitions="132,Auto,*" ColumnSpacing="10">
                            <TextBlock Text="{Binding BackgroundImageOpacityText}"
                                       VerticalAlignment="Center"
                                       Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                            <atom:NumericUpDown Grid.Column="1"
                                                Width="92"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="{Binding BackgroundImageOpacity, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="{Binding ThemeText}"
                           FontWeight="SemiBold"
                           Foreground="{atom:SharedTokenResource ColorText}"/>
                <StackPanel Orientation="Horizontal" Spacing="18">
                    <atom:RadioButton Content="{Binding DarkThemeText}"
                                      GroupName="ApplicationTheme"
                                      IsChecked="{Binding IsDarkThemeSelected, Mode=TwoWay}"/>
                    <atom:RadioButton Content="{Binding LightThemeText}"
                                      GroupName="ApplicationTheme"
                                      IsChecked="{Binding IsLightThemeSelected, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="{Binding NetworkText}"
                           FontWeight="SemiBold"
                           Foreground="{atom:SharedTokenResource ColorText}"/>
                <Border Background="{atom:SharedTokenResource ColorBgLayout}"
                        BorderBrush="{atom:SharedTokenResource ColorSplit}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,10">
                    <StackPanel Spacing="9">
                        <TextBlock Text="{Binding GlobalProxyText}"
                                   FontWeight="SemiBold"
                                   Foreground="{atom:SharedTokenResource ColorText}"/>
                        <atom:CheckBox Content="{Binding GlobalProxyEnabledText}"
                                       IsChecked="{Binding GlobalProxyEnabled, Mode=TwoWay}"/>
                        <Grid ColumnDefinitions="132,*"
                              ColumnSpacing="10"
                              IsEnabled="{Binding GlobalProxyEnabled}">
                            <TextBlock Text="{Binding GlobalProxyTypeText}"
                                       VerticalAlignment="Center"
                                       Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                            <atom:Select Grid.Column="1"
                                         OptionsSource="{Binding GlobalProxyTypeOptions}"
                                         SelectedOption="{Binding GlobalProxyTypeOption, Mode=TwoWay}"
                                         HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid ColumnDefinitions="132,*"
                              ColumnSpacing="10"
                              IsEnabled="{Binding GlobalProxyEnabled}">
                            <TextBlock Text="{Binding GlobalProxyHostText}"
                                       VerticalAlignment="Center"
                                       Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                            <atom:TextBox Grid.Column="1"
                                          Text="{Binding GlobalProxyHost, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="132,Auto"
                              ColumnSpacing="10"
                              IsEnabled="{Binding GlobalProxyEnabled}">
                            <TextBlock Text="{Binding GlobalProxyPortText}"
                                       VerticalAlignment="Center"
                                       Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                            <atom:NumericUpDown Grid.Column="1"
                                                Width="92"
                                                Minimum="0"
                                                Maximum="65535"
                                                Value="{Binding GlobalProxyPort, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="132,*"
                              ColumnSpacing="10"
                              IsEnabled="{Binding GlobalProxyEnabled}">
                            <TextBlock Text="{Binding GlobalProxyUsernameText}"
                                       VerticalAlignment="Center"
                                       Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                            <atom:TextBox Grid.Column="1"
                                          Text="{Binding GlobalProxyUsername, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="132,*"
                              ColumnSpacing="10"
                              IsEnabled="{Binding GlobalProxyEnabled}">
                            <TextBlock Text="{Binding GlobalProxyPasswordText}"
                                       VerticalAlignment="Center"
                                       Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                            <atom:TextBox Grid.Column="1"
                                          Text="{Binding GlobalProxyPassword, Mode=TwoWay}"
                                          PasswordChar="*"
                                          IsEnableRevealButton="True"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="{Binding UpdatesText}"
                           FontWeight="SemiBold"
                           Foreground="{atom:SharedTokenResource ColorText}"/>
                <Border Background="{atom:SharedTokenResource ColorBgLayout}"
                        BorderBrush="{atom:SharedTokenResource ColorSplit}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,10">
                    <StackPanel Spacing="8">
                        <atom:CheckBox Content="{Binding AutoCheckForUpdatesText}"
                                       IsChecked="{Binding AutoCheckForUpdates, Mode=TwoWay}"/>
                        <atom:CheckBox Content="{Binding IncludePrereleaseUpdatesText}"
                                       IsChecked="{Binding IncludePrereleaseUpdates, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="{Binding LanguageText}"
                           FontWeight="SemiBold"
                           Foreground="{atom:SharedTokenResource ColorText}"/>
                <StackPanel Orientation="Horizontal" Spacing="18">
                    <atom:RadioButton Content="{Binding ChineseText}"
                                      GroupName="ApplicationLanguage"
                                      IsChecked="{Binding IsChineseSelected, Mode=TwoWay}"/>
                    <atom:RadioButton Content="{Binding EnglishText}"
                                      GroupName="ApplicationLanguage"
                                      IsChecked="{Binding IsEnglishSelected, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="{Binding RecordingText}"
                           FontWeight="SemiBold"
                           Foreground="{atom:SharedTokenResource ColorText}"/>
                <Border Background="{atom:SharedTokenResource ColorBgLayout}"
                        BorderBrush="{atom:SharedTokenResource ColorSplit}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,10">
                    <StackPanel Spacing="8">
                        <atom:CheckBox Content="{Binding RecordTerminalSessionsText}"
                                       IsChecked="{Binding RecordTerminalSessions, Mode=TwoWay}"/>
                        <TextBlock Text="{Binding RecordingDescriptionText}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{atom:SharedTokenResource ColorTextTertiary}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding RecordingRetentionText}"
                                       VerticalAlignment="Center"
                                       Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                            <atom:NumericUpDown Width="96"
                                                Minimum="1"
                                                Maximum="3650"
                                                Value="{Binding RecordingRetentionDays, Mode=TwoWay}"/>
                            <TextBlock Text="{Binding RecordingDaysText}"
                                       VerticalAlignment="Center"
                                       Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="{Binding SshSecurityText}"
                           FontWeight="SemiBold"
                           Foreground="{atom:SharedTokenResource ColorText}"/>
                <Border Background="{atom:SharedTokenResource ColorBgLayout}"
                        BorderBrush="{atom:SharedTokenResource ColorSplit}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,10">
                    <StackPanel Spacing="9">
                        <atom:CheckBox Content="{Binding ConfirmSshHostKeyOnFirstConnectionText}"
                                       IsChecked="{Binding ConfirmSshHostKeyOnFirstConnection, Mode=TwoWay}"/>
                        <atom:CheckBox Content="{Binding BlockChangedSshHostKeysText}"
                                       IsChecked="{Binding BlockChangedSshHostKeys, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="{Binding ExternalLaunchText}"
                           FontWeight="SemiBold"
                           Foreground="{atom:SharedTokenResource ColorText}"/>
                <Border Background="{atom:SharedTokenResource ColorBgLayout}"
                        BorderBrush="{atom:SharedTokenResource ColorSplit}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,10">
                    <StackPanel Spacing="9">
                        <atom:CheckBox Content="{Binding AllowExternalLaunchText}"
                                       IsChecked="{Binding AllowExternalLaunch, Mode=TwoWay}"/>
                        <atom:CheckBox Content="{Binding ConfirmExternalLaunchText}"
                                       IsChecked="{Binding ConfirmExternalLaunch, Mode=TwoWay}"/>
                        <atom:CheckBox Content="{Binding RegisterExternalUrlProtocolsText}"
                                       IsChecked="{Binding RegisterExternalUrlProtocols, Mode=TwoWay}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding ExternalLaunchTrustCountText}"
                                       VerticalAlignment="Center"
                                       Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                            <atom:Button Content="{Binding ClearTrustedExternalLaunchTargetsText}"
                                         Command="{Binding ClearTrustedExternalLaunchTargetsCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
