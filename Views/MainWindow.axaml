<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="using:CxShell.Services"
             xmlns:atom="https://atomui.net"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:models="using:CxShell.Models"
             xmlns:controls="using:CxShell.Controls"
             xmlns:vm="using:CxShell.ViewModels"
             xmlns:views="using:CxShell.Views"
             x:Class="CxShell.Views.MainWindow"
             x:Name="MainWindowRoot"
             x:DataType="vm:MainWindowViewModel"
             Title=""
             WindowDecorationsTheme="{DynamicResource {x:Type chrome:WindowDrawnDecorations}}"
             Icon="/Assets/CxShellLogo.png"
             Width="1200"
             Height="800"
             MinWidth="600"
             MinHeight="400"
             WindowState="Normal"
             WindowStartupLocation="CenterScreen">

    <atom:Window.LogoTemplate>
        <DataTemplate>
            <Image Source="/Assets/CxShellLogo.png"/>
        </DataTemplate>
    </atom:Window.LogoTemplate>

    <atom:Window.LeftAddOn>
        <StackPanel x:Name="LeftToolbarAddOn"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsMainChromeVisible}">
            <atom:TextBlock Text="CxShell"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Margin="8,0,8,0"
                            IsHitTestVisible="False"
                            VerticalAlignment="Center"/>
            <!-- The primary actions share one AtomUI title-bar menu so direct actions
                 and actions with a secondary choice use the same interaction model. -->
            <atom:Menu x:Name="ToolbarMenu"
                       SizeType="Small"
                       IsMotionEnabled="False"
                       Background="Transparent"
                       BorderThickness="0"
                       VerticalAlignment="Center">
                <atom:MenuItem Command="{Binding NewSessionCommand}"
                               atom:ToolTip.Tip="{Binding NewSessionToolTip}"
                               atom:ToolTip.Placement="Bottom">
                    <atom:MenuItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <atom:IconPresenter Icon="{antdicons:AntDesignIconProvider Kind=PlusOutlined}"
                                                Width="14"
                                                Height="14"/>
                            <atom:TextBlock Classes="toolbar-menu-label"
                                            Text="{Binding NewSessionText}"
                                            VerticalAlignment="Center"/>
                        </StackPanel>
                    </atom:MenuItem.Header>
                </atom:MenuItem>
                <atom:MenuItem Command="{Binding ShowSessionManagerCommand}"
                               atom:ToolTip.Tip="{Binding SessionManagerToolTip}"
                               atom:ToolTip.Placement="Bottom">
                    <atom:MenuItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <atom:IconPresenter Icon="{antdicons:AntDesignIconProvider Kind=UnorderedListOutlined}"
                                                Width="14"
                                                Height="14"/>
                            <atom:TextBlock Classes="toolbar-menu-label"
                                            Text="{Binding SessionManagerText}"
                                            VerticalAlignment="Center"/>
                        </StackPanel>
                    </atom:MenuItem.Header>
                </atom:MenuItem>
                <atom:MenuItem x:Name="LocalTerminalMenuItem"
                               IsEnabled="{Binding HasLocalTerminalProfiles}"
                               Loaded="OnLocalTerminalMenuItemLoaded"
                               atom:ToolTip.Tip="{Binding LocalTerminalToolTip}"
                               atom:ToolTip.Placement="Bottom">
                    <atom:MenuItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <atom:IconPresenter Icon="{antdicons:AntDesignIconProvider Kind=CodeOutlined}"
                                                Width="14"
                                                Height="14"/>
                            <atom:TextBlock Classes="toolbar-menu-label"
                                            Text="{Binding LocalTerminalText}"
                                            VerticalAlignment="Center"/>
                        </StackPanel>
                    </atom:MenuItem.Header>
                </atom:MenuItem>
                <atom:MenuSeparator/>
                <atom:MenuItem Command="{Binding ToggleSftpCommand}"
                               atom:ToolTip.Tip="{Binding SftpToolTip}"
                               atom:ToolTip.Placement="Bottom">
                    <atom:MenuItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <atom:IconPresenter Icon="{antdicons:AntDesignIconProvider Kind=SwapOutlined}"
                                                Width="14"
                                                Height="14"/>
                            <atom:TextBlock Classes="toolbar-menu-label"
                                            Text="SFTP"
                                            VerticalAlignment="Center"/>
                        </StackPanel>
                    </atom:MenuItem.Header>
                </atom:MenuItem>
                <atom:MenuItem Command="{Binding ToggleMonitorCommand}"
                               atom:ToolTip.Tip="{Binding MonitorToolTip}"
                               atom:ToolTip.Placement="Bottom">
                    <atom:MenuItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <atom:IconPresenter Icon="{antdicons:AntDesignIconProvider Kind=DashboardOutlined}"
                                                Width="14"
                                                Height="14"/>
                            <atom:TextBlock Classes="toolbar-menu-label"
                                            Text="{Binding MonitorText}"
                                            VerticalAlignment="Center"/>
                        </StackPanel>
                    </atom:MenuItem.Header>
                </atom:MenuItem>
                <atom:MenuItem Command="{Binding ShowSshTunnelCenterCommand}"
                               atom:ToolTip.Tip="{Binding TunnelsToolTip}"
                               atom:ToolTip.Placement="Bottom">
                    <atom:MenuItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <atom:IconPresenter Icon="{antdicons:AntDesignIconProvider Kind=DeploymentUnitOutlined}"
                                                Width="14"
                                                Height="14"/>
                            <atom:TextBlock Classes="toolbar-menu-label"
                                            Text="{Binding TunnelsText}"
                                            VerticalAlignment="Center"/>
                        </StackPanel>
                    </atom:MenuItem.Header>
                </atom:MenuItem>
                <atom:MenuItem Click="OnAgentPanelToggleClick"
                               atom:ToolTip.Tip="{Binding AgentToolTip}"
                               atom:ToolTip.Placement="Bottom">
                    <atom:MenuItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <atom:IconPresenter Icon="{antdicons:AntDesignIconProvider Kind=RobotOutlined}"
                                                Width="14"
                                                Height="14"/>
                            <atom:TextBlock Classes="toolbar-menu-label"
                                            Text="{Binding AgentText}"
                                            VerticalAlignment="Center"/>
                            <Border IsVisible="{Binding HasActiveAgentRuns}"
                                    Background="{atom:SharedTokenResource ColorPrimaryBg}"
                                    BorderBrush="{atom:SharedTokenResource ColorPrimary}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="4,0"
                                    MinWidth="18"
                                    HorizontalAlignment="Center">
                                <atom:TextBlock Text="{Binding AgentActivityCountText}"
                                                Foreground="{atom:SharedTokenResource ColorPrimary}"
                                                FontSize="10"
                                                TextAlignment="Center"
                                                VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </atom:MenuItem.Header>
                </atom:MenuItem>
                <atom:MenuItem Command="{Binding ToggleTabBarCommand}"
                               atom:ToolTip.Tip="{Binding TabBarToolTip}"
                               atom:ToolTip.Placement="Bottom">
                    <atom:MenuItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <atom:IconPresenter Icon="{antdicons:AntDesignIconProvider Kind=MenuOutlined}"
                                                Width="14"
                                                Height="14"/>
                            <atom:TextBlock Classes="toolbar-menu-label"
                                            Text="{Binding TabBarText}"
                                            VerticalAlignment="Center"/>
                        </StackPanel>
                    </atom:MenuItem.Header>
                </atom:MenuItem>
                <atom:MenuSeparator/>
                <atom:MenuItem atom:ToolTip.Tip="{Binding ArrangeToolTip}"
                               atom:ToolTip.Placement="Bottom">
                    <atom:MenuItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <atom:IconPresenter Icon="{antdicons:AntDesignIconProvider Kind=LayoutOutlined}"
                                                Width="14"
                                                Height="14"/>
                            <atom:TextBlock Classes="toolbar-menu-label"
                                            Text="{Binding ArrangeText}"
                                            VerticalAlignment="Center"/>
                        </StackPanel>
                    </atom:MenuItem.Header>
                    <atom:MenuItem Header="{Binding ArrangeVerticalText}"
                                   Click="OnArrangeVerticalMenuItemClick"/>
                    <atom:MenuItem Header="{Binding ArrangeHorizontalText}"
                                   Click="OnArrangeHorizontalMenuItemClick"/>
                    <atom:MenuItem Header="{Binding ArrangeTileText}"
                                   Click="OnArrangeTileMenuItemClick"/>
                    <atom:MenuSeparator/>
                    <atom:MenuItem Header="{Binding ArrangeMergeText}"
                                   Click="OnArrangeMergeMenuItemClick"/>
                </atom:MenuItem>
            </atom:Menu>
        </StackPanel>
    </atom:Window.LeftAddOn>

    <atom:Window.RightAddOn>
        <StackPanel x:Name="RightToolbarAddOn"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsMainChromeVisible}">
            <atom:Menu x:Name="LanguageMenu"
                       SizeType="Small"
                       IsMotionEnabled="False"
                       Background="Transparent"
                       BorderThickness="0"
                       VerticalAlignment="Center">
                <atom:MenuItem atom:ToolTip.Tip="{Binding LanguageToolTip}"
                               atom:ToolTip.Placement="Bottom">
                    <atom:MenuItem.Header>
                        <atom:TextBlock Text="{Binding LanguageIcon}"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        MinWidth="18"
                                        TextAlignment="Center"/>
                    </atom:MenuItem.Header>
                    <atom:MenuItem Header="{Binding ChineseLanguageText}"
                                   Click="OnChineseLanguageMenuItemClick"/>
                    <atom:MenuItem Header="{Binding EnglishLanguageText}"
                                   Click="OnEnglishLanguageMenuItemClick"/>
                </atom:MenuItem>
            </atom:Menu>
            <atom:Button ButtonType="Default"
                         Width="32"
                         Height="30"
                         Padding="0"
                         Background="Transparent"
                         BorderBrush="Transparent"
                         BorderThickness="0"
                         Command="{Binding ToggleThemeCommand}"
                         atom:ToolTip.Tip="{Binding ThemeToolTip}"
                         atom:ToolTip.Placement="Bottom">
                <atom:TextBlock Text="{Binding ThemeIcon}" FontSize="14"
                                TextAlignment="Center" VerticalAlignment="Center"/>
            </atom:Button>
            <atom:Button ButtonType="Default"
                         Width="32"
                         Height="30"
                         Padding="0"
                         Background="Transparent"
                         BorderBrush="Transparent"
                         BorderThickness="0"
                         Command="{Binding ToggleTerminalFullScreenCommand}"
                         atom:ToolTip.Tip="{Binding FullScreenToolTip}"
                         atom:ToolTip.Placement="Bottom">
                <atom:TextBlock Text="⛶"
                                FontSize="14"
                                Width="18"
                                TextAlignment="Center"
                                VerticalAlignment="Center"/>
            </atom:Button>
            <atom:Button x:Name="SettingsButton"
                         Width="32"
                         Height="30"
                         Padding="0"
                         ButtonType="Default"
                         Background="Transparent"
                         BorderBrush="Transparent"
                         BorderThickness="0"
                         Icon="{antdicons:AntDesignIconProvider Kind=SettingOutlined}"
                         Command="{Binding ShowApplicationSettingsCommand}"
                         atom:ToolTip.Tip="{Binding SettingsToolTip}"
                         atom:ToolTip.Placement="Bottom"/>
        </StackPanel>
    </atom:Window.RightAddOn>

    <atom:Window.Styles>
        <Style Selector="atom|TextBlock.toolbar-menu-label">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI,PingFang SC,Noto Sans CJK SC,sans-serif"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="atom|CardTabStrip.quick-session-tab-strip">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgLayout}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="atom|CardTabStrip.quick-session-tab-strip /template/ ItemsPresenter#PART_ItemsPresenter StackPanel">
            <Setter Property="Spacing" Value="0"/>
        </Style>
        <Style Selector="atom|CardTabStrip.quick-session-tab-strip atom|TabStripItem">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgLayout}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorText}"/>
            <Setter Property="Margin" Value="0,2,4,2"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="8,0"/>
            <Style Selector="^ /template/ Border#Frame">
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
        </Style>
        <Style Selector="atom|CardTabStrip.quick-session-tab-strip atom|TabStripItem:pointerover:not(:selected)">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorPrimaryBg}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorPrimaryHover}"/>
        </Style>
        <Style Selector="atom|CardTabStrip.quick-session-tab-strip atom|TabStripItem:selected">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgLayout}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorText}"/>
        </Style>
        <Style Selector="atom|CardTabStrip.quick-session-tab-strip atom|TabStripItem atom|IconPresenter">
            <Setter Property="IconBrush" Value="{atom:SharedTokenResource ColorTextSecondary}"/>
        </Style>
        <Style Selector="atom|CardTabStrip.quick-session-tab-strip atom|TabStripItem:pointerover atom|IconPresenter">
            <Setter Property="IconBrush" Value="{atom:SharedTokenResource ColorPrimaryHover}"/>
        </Style>
        <Style Selector="atom|CardTabStrip.quick-session-tab-strip atom|TabStripItem:selected atom|IconPresenter">
            <Setter Property="IconBrush" Value="{atom:SharedTokenResource ColorTextSecondary}"/>
        </Style>
        <Style Selector="atom|TabStrip.session-tab-strip /template/ Border#PART_SelectedItemIndicator">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="atom|TabStrip.session-tab-strip /template/ ItemsPresenter#PART_ItemsPresenter StackPanel">
            <Setter Property="Spacing" Value="0"/>
        </Style>
        <Style Selector="atom|TabStrip.session-tab-strip atom|TabStripItem">
            <Setter Property="Background" Value="{Binding TabBackgroundBrush, x:CompileBindings=False}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Style Selector="^ /template/ Border#Frame">
                <Setter Property="CornerRadius" Value="8,8,0,0"/>
                <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorBorderSecondary}"/>
                <Setter Property="BorderThickness" Value="1,1,1,0"/>
                <Setter Property="MinHeight" Value="34"/>
            </Style>
            <Style Selector="^ /template/ atom|IconButton#PART_ItemCloseButton">
                <Setter Property="Margin" Value="6,0,8,0"/>
            </Style>
        </Style>
        <Style Selector="atom|TabStrip.session-tab-strip atom|TabStripItem:pointerover:not(:selected)">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorFillQuaternary}"/>
        </Style>
        <Style Selector="atom|TabStrip.session-tab-strip atom|TabStripItem:selected">
            <Setter Property="Margin" Value="0,2,0,-1"/>
            <Style Selector="^ /template/ Border#Frame">
                <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorBorder}"/>
            </Style>
        </Style>
        <Style Selector="atom|ListBox.recent-session-list">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgContainer}"/>
            <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorBorderSecondary}"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style Selector="atom|ListBox.recent-session-list atom|ListBoxItem">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="58"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </atom:Window.Styles>

    <atom:Window.Resources>
        <DataTemplate x:Key="QuickSessionTabTemplate" DataType="models:SessionInfo">
            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        PointerPressed="OnQuickSessionTagPointerPressed"
                        PointerReleased="OnQuickSessionTagPointerReleased"
                        VerticalAlignment="Center">
                <atom:IconPresenter Icon="{antdicons:AntDesignIconProvider CloudServerOutlined}"
                                    Width="14"
                                    Height="14"
                                    VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="160"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="TabHeaderTemplate" DataType="vm:TerminalTabViewModel">
            <Border MinWidth="72"
                    MaxWidth="220"
                    Padding="8,0,0,0"
                    PointerPressed="OnTabHeaderPointerPressed">
                <StackPanel Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                    <Ellipse Width="8"
                             Height="8"
                             Fill="{Binding ConnectionIndicatorBrush}"
                             VerticalAlignment="Center"
                             atom:ToolTip.Tip="{Binding ConnectionIndicatorText}"/>
                    <atom:IconPresenter IsVisible="{Binding HasTabIcon}"
                                        Icon="{Binding TabIcon}"
                                        Width="14"
                                        Height="14"
                                        IconBrush="{atom:SharedTokenResource ColorTextSecondary}"
                                        VerticalAlignment="Center"/>
                    <atom:TextBlock Text="{Binding Title}"
                                    FontSize="12"
                                    MaxWidth="160"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    Foreground="{Binding IsSelected, Converter={x:Static vm:TabSelectedFgConverter.Instance}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ArrangedTabPaneTemplate" DataType="vm:TerminalTabGroupViewModel">
            <Border Margin="1"
                    Background="{atom:SharedTokenResource ColorBgLayout}"
                    BorderBrush="{atom:SharedTokenResource ColorSplit}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    PointerPressed="OnTabGroupPanePointerPressed">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            MinHeight="36"
                            Background="{atom:SharedTokenResource ColorBgLayout}"
                            BorderBrush="{atom:SharedTokenResource ColorBorder}"
                            BorderThickness="0,0,0,1">
                        <atom:TabStrip ItemsSource="{Binding Tabs}"
                                       Classes="session-tab-strip"
                                       SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                                       ItemTemplate="{StaticResource TabHeaderTemplate}"
                                       IsTabReorderEnabled="True"
                                       TabActivationTrigger="PointerReleased"
                                       IsTabClosable="True"
                                       IsTabAutoHideCloseButton="False"
                                       IsMotionEnabled="False"
                                       SizeType="Small"
                                       HeaderStartEdgePadding="4"
                                       HeaderEndEdgePadding="4"
                                       BorderThickness="0"
                                       Closing="OnTabStripClosing"/>
                    </Border>
                    <Grid Grid.Row="1"
                          Background="{atom:SharedTokenResource ColorBgLayout}">
                        <Grid IsVisible="{Binding IsSelectedTerminalSession}"
                              RowDefinitions="Auto,*">
                            <Border Grid.Row="0"
                                    IsVisible="{Binding SelectedTab.IsKeyboardBroadcastBarVisible}"
                                    Background="#FFFBE6"
                                    BorderBrush="#FFE58F"
                                    BorderThickness="0,0,0,1"
                                    Padding="10,4">
                                <DockPanel LastChildFill="True">
                                    <atom:ToggleSwitch DockPanel.Dock="Right"
                                                       SizeType="Small"
                                                       IsChecked="{Binding SelectedTab.IsKeyboardBroadcastEnabled, Mode=TwoWay}"
                                                       ToolTip.Tip="{Binding SelectedTab.KeyboardBroadcastReceiveText}"
                                                       VerticalAlignment="Center"/>
                                    <atom:TextBlock Text="{Binding SelectedTab.KeyboardBroadcastStatusText}"
                                                    Foreground="#874D00"
                                                    FontSize="12"
                                                    VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <views:TerminalView Grid.Row="1"
                                                DataContext="{Binding SelectedTab.Terminal, x:CompileBindings=False}"/>
                        </Grid>
                        <Grid IsVisible="{Binding IsSelectedVncSession}">
                            <views:VncView DataContext="{Binding SelectedTab.Vnc, x:CompileBindings=False}"/>
                        </Grid>
                        <Grid IsVisible="{Binding IsSelectedRdpSession}">
                            <views:RdpView DataContext="{Binding SelectedTab.Rdp, x:CompileBindings=False}"/>
                        </Grid>
                        <Grid IsVisible="{Binding IsSelectedFileTransferSession}">
                            <views:SftpPanelView DataContext="{Binding SelectedTab.FileTransfer, x:CompileBindings=False}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </atom:Window.Resources>



    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 工具栏 -->
        <Border Grid.Row="0" Padding="8,4"
                IsVisible="False"
                Background="{atom:SharedTokenResource ColorBgContainer}">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <atom:Button Command="{Binding NewSessionCommand}"
                             ButtonType="Default"
                             atom:ToolTip.Tip="{Binding NewSessionToolTip}"
                             atom:ToolTip.Placement="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <atom:TextBlock Text="+" FontSize="16" FontWeight="Bold" Width="18"
                                        TextAlignment="Center" VerticalAlignment="Center"/>
                        <atom:TextBlock Text="{Binding NewSessionText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </atom:Button>
                <atom:Button Command="{Binding ShowSessionManagerCommand}"
                             ButtonType="Default"
                             atom:ToolTip.Tip="{Binding SessionManagerToolTip}"
                             atom:ToolTip.Placement="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <atom:TextBlock Text="☰" FontSize="16" Width="18"
                                        TextAlignment="Center" VerticalAlignment="Center"/>
                        <atom:TextBlock Text="{Binding SessionManagerText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </atom:Button>
                <atom:Button Click="OnLocalTerminalButtonClick"
                             ButtonType="Default"
                             Icon="{antdicons:AntDesignIconProvider Kind=CodeOutlined}"
                             IsEnabled="{Binding HasLocalTerminalProfiles}"
                             atom:ToolTip.Tip="{Binding LocalTerminalToolTip}"
                             atom:ToolTip.Placement="Bottom"
                             Content="{Binding LocalTerminalText}"/>
                <Border Width="1" Background="{atom:SharedTokenResource ColorSplit}" Margin="8,4" Opacity="0.6" IsVisible="False"/>
                <atom:Button Command="{Binding CurrentConnectCommand}"
                             IsVisible="False"
                             ButtonType="Default"
                             atom:ToolTip.Tip="{Binding ConnectToolTip}"
                             atom:ToolTip.Placement="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <atom:TextBlock Text="▶" FontSize="12" Width="18"
                                        TextAlignment="Center" VerticalAlignment="Center"/>
                        <atom:TextBlock Text="{Binding ConnectText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </atom:Button>
                <atom:Button Command="{Binding CurrentDisconnectCommand}"
                             IsVisible="False"
                             ButtonType="Default"
                             atom:ToolTip.Tip="{Binding DisconnectToolTip}"
                             atom:ToolTip.Placement="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <atom:TextBlock Text="■" FontSize="11" Width="18"
                                        TextAlignment="Center" VerticalAlignment="Center"/>
                        <atom:TextBlock Text="{Binding DisconnectText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </atom:Button>
                <Border Width="1" Background="{atom:SharedTokenResource ColorSplit}" Margin="8,4" Opacity="0.6"/>
                <atom:Button Command="{Binding ToggleSftpCommand}"
                             ButtonType="Default"
                             atom:ToolTip.Tip="{Binding SftpToolTip}"
                             atom:ToolTip.Placement="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <atom:TextBlock Text="⇅" FontSize="14" Width="18"
                                        TextAlignment="Center" VerticalAlignment="Center"/>
                        <atom:TextBlock Text="SFTP" VerticalAlignment="Center"/>
                    </StackPanel>
                </atom:Button>
                <atom:Button Command="{Binding ToggleMonitorCommand}"
                             ButtonType="Default"
                             atom:ToolTip.Tip="{Binding MonitorToolTip}"
                             atom:ToolTip.Placement="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <atom:TextBlock Text="▦" FontSize="14" Width="18"
                                        TextAlignment="Center" VerticalAlignment="Center"/>
                        <atom:TextBlock Text="{Binding MonitorText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </atom:Button>
                <atom:Button Command="{Binding ShowSshTunnelCenterCommand}"
                             ButtonType="Default"
                             Icon="{antdicons:AntDesignIconProvider Kind=DeploymentUnitOutlined}"
                             atom:ToolTip.Tip="{Binding TunnelsToolTip}"
                             atom:ToolTip.Placement="Bottom">
                    <atom:TextBlock Text="{Binding TunnelsText}" VerticalAlignment="Center"/>
                </atom:Button>
                <atom:Button Click="OnAgentPanelToggleClick"
                             ButtonType="Default"
                             Icon="{antdicons:AntDesignIconProvider Kind=RobotOutlined}"
                             atom:ToolTip.Tip="{Binding AgentToolTip}"
                             atom:ToolTip.Placement="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <atom:TextBlock Text="{Binding AgentText}" VerticalAlignment="Center"/>
                        <Border IsVisible="{Binding HasActiveAgentRuns}"
                                Background="{atom:SharedTokenResource ColorPrimaryBg}"
                                BorderBrush="{atom:SharedTokenResource ColorPrimary}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4,0"
                                MinWidth="18"
                                HorizontalAlignment="Center">
                            <atom:TextBlock Text="{Binding AgentActivityCountText}"
                                            Foreground="{atom:SharedTokenResource ColorPrimary}"
                                            FontSize="10"
                                            TextAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </atom:Button>
                <atom:Button Command="{Binding ToggleTabBarCommand}"
                             ButtonType="Default"
                             Icon="{antdicons:AntDesignIconProvider Kind=MenuOutlined}"
                             atom:ToolTip.Tip="{Binding TabBarToolTip}"
                             atom:ToolTip.Placement="Bottom">
                    <atom:TextBlock Text="{Binding TabBarText}" VerticalAlignment="Center"/>
                </atom:Button>
                <!-- 主题切换 -->
                <Border Width="1" Background="{atom:SharedTokenResource ColorSplit}" Margin="8,4" Opacity="0.6"/>
                <atom:Button ButtonType="Default" Command="{Binding ToggleThemeCommand}"
                             atom:ToolTip.Tip="{Binding ThemeToolTip}"
                             atom:ToolTip.Placement="Bottom">
                    <atom:TextBlock Text="{Binding ThemeIcon}" FontSize="14"
                                    TextAlignment="Center" VerticalAlignment="Center"/>
                </atom:Button>
                <atom:Button ButtonType="Default" Command="{Binding ToggleTerminalFullScreenCommand}"
                             atom:ToolTip.Tip="{Binding FullScreenToolTip}"
                             atom:ToolTip.Placement="Bottom">
                    <atom:TextBlock Text="⛶"
                                    FontSize="14"
                                    Width="18"
                                    TextAlignment="Center"
                                    VerticalAlignment="Center"/>
                </atom:Button>
                <atom:Button ButtonType="Default"
                                     x:Name="ArrangeMenuButtonFallback"
                                     Icon="{antdicons:AntDesignIconProvider Kind=LayoutOutlined}"
                                     atom:ToolTip.Tip="{Binding ArrangeToolTip}"
                                     atom:ToolTip.Placement="Bottom"/>
                <atom:Button ButtonType="Default"
                                     x:Name="LanguageMenuButtonFallback"
                                     atom:ToolTip.Tip="{Binding LanguageToolTip}"
                                     atom:ToolTip.Placement="Bottom">
                    <atom:Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <atom:TextBlock Text="{Binding LanguageIcon}"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            MinWidth="18"
                                            TextAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </StackPanel>
                    </atom:Button.Content>
                </atom:Button>
            </StackPanel>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="0"
                Height="44"
                Padding="8,5"
                ClipToBounds="False"
                 IsVisible="{Binding IsQuickSessionBarVisible}"
                 Background="{atom:SharedTokenResource ColorBgLayout}"
                BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                BorderThickness="0,1,0,1">
            <DockPanel LastChildFill="True"
                       ClipToBounds="False"
                       VerticalAlignment="Center">
                <atom:Button DockPanel.Dock="Left"
                               Width="28"
                               Height="28"
                              Padding="0"
                              ButtonType="Default"
                              Shape="Default"
                              SizeType="Small"
                              Icon="{antdicons:AntDesignIconProvider PlusOutlined}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             Command="{Binding AddCurrentSessionToQuickBarCommand}"
                             atom:ToolTip.Tip="{Binding AddQuickSessionToolTip}"
                             atom:ToolTip.Placement="Bottom"/>
                <atom:CardTabStrip x:Name="QuickSessionTabStrip"
                                   ItemsSource="{Binding QuickSessions}"
                                   Classes="quick-session-tab-strip"
                                   ItemTemplate="{StaticResource QuickSessionTabTemplate}"
                                   IsTabReorderEnabled="True"
                                   TabActivationTrigger="PointerReleased"
                                   IsTabClosable="False"
                                   IsTabAutoHideCloseButton="False"
                                   IsMotionEnabled="False"
                                   IsShowAddTabButton="False"
                                   HeaderStartEdgePadding="0"
                                   HeaderEndEdgePadding="0"
                                   BorderThickness="0"
                                   SelectionChanged="OnQuickSessionSelectionChanged"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Padding="8,4"
                MinHeight="40"
                IsVisible="{Binding IsMainChromeVisible}"
                Background="{atom:SharedTokenResource ColorBgContainer}"
                BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True"
                       VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsSelectedRdpToolbarVisible}">
                    <atom:Button Content="{Binding [Rdp.Keyboard.Combinations], Source={x:Static services:LocalizationService.Shared}}"
                                 Padding="12,5"
                                 IsEnabled="{Binding SelectedTab.Rdp.IsConnected}"
                                 Click="OnRdpKeyCombinationsClick"/>
                    <atom:Button Content="Ctrl+Alt+Del"
                                 Padding="12,5"
                                 IsEnabled="{Binding SelectedTab.Rdp.IsConnected}"
                                 Click="OnSendRdpCtrlAltDelClick"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsSelectedVncToolbarVisible}">
                    <atom:Button Content="{Binding [UiText.259], Source={x:Static services:LocalizationService.Shared}}"
                                 Padding="12,5"
                                 Click="OnSendRemoteClipboardClick"/>
                    <atom:Button Content="Ctrl+Alt+Del"
                                 Padding="12,5"
                                 Click="OnSendRemoteCtrlAltDelClick"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="16"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4"
                                VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8"
                                 VerticalAlignment="Center"
                                 Fill="{Binding ConnectionStatusColor}"/>
                        <atom:TextBlock Text="{Binding ConnectionStatusText}"
                                        VerticalAlignment="Center"/>
                    </StackPanel>
                    <atom:TextBlock Text="{Binding ConnectedHostInfo}"
                                    VerticalAlignment="Center"
                                    Opacity="0.8"/>
                    <atom:TextBlock Text="{Binding TerminalSizeText}"
                                    VerticalAlignment="Center"
                                    Opacity="0.8"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid x:Name="MainContentGrid"
                  Background="{atom:SharedTokenResource ColorBgLayout}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0"/>
                    <ColumnDefinition Width="{Binding SftpSplitterWidth}"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="{Binding AgentSplitterWidth}"/>
                    <ColumnDefinition Width="{Binding AgentPanelColumnWidth}"/>
                </Grid.ColumnDefinitions>

                <!-- Col 0: 左侧 SFTP 面板 -->
                <Border Grid.Column="0"
                        x:Name="SftpPanelHost"
                        IsVisible="{Binding IsSftpPanelVisible}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        ClipToBounds="True">
                    <views:SftpPanelView DataContext="{Binding Sftp, x:CompileBindings=False}"
                                         IsPanelCloseButtonVisible="True"
                                         PanelCloseCommand="{Binding $parent[Window].DataContext.ToggleSftpCommand, x:CompileBindings=False}"/>
                </Border>
                <Border Grid.Column="1"
                        x:Name="SftpSplitterHandle"
                        IsVisible="{Binding IsSftpPanelVisible}"
                        HorizontalAlignment="Stretch"
                        Background="{atom:SharedTokenResource ColorBgLayout}"
                        Cursor="SizeWestEast"
                        PointerPressed="OnSftpSplitterPointerPressed"
                        PointerMoved="OnSftpSplitterPointerMoved"
                        PointerReleased="OnSftpSplitterPointerReleased">
                    <Border Width="1"
                            HorizontalAlignment="Center"
                            Background="{atom:SharedTokenResource ColorBorderSecondary}"/>
                </Border>

                <!-- Col 1: 首屏与终端区域 -->
                <Grid Grid.Column="2"
                      Background="{atom:SharedTokenResource ColorBgLayout}">
                    <!-- 无标签时显示最近连接首屏 -->
                    <Grid IsVisible="{Binding !HasTabs}"
                          Background="{atom:SharedTokenResource ColorBgContainer}">
                        <Grid MaxWidth="720"
                              Margin="24"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RowDefinitions="Auto,Auto,Auto"
                              IsVisible="{Binding HasRecentSessions}">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="4">
                                    <atom:TextBlock Text="{Binding RecentConnectionsText}"
                                                    FontSize="22"
                                                    FontWeight="SemiBold"
                                                    Foreground="{atom:SharedTokenResource ColorText}"/>
                                    <atom:TextBlock Text="{Binding RecentConnectionsHintText}"
                                                    FontSize="12"
                                                    Foreground="{atom:SharedTokenResource ColorTextTertiary}"/>
                                </StackPanel>
                                <atom:Button Grid.Column="1"
                                             Content="{Binding ViewAllSessionsText}"
                                             Command="{Binding ShowRecentConnectionsCommand}"
                                             ButtonType="Link"
                                             SizeType="Small"
                                             VerticalAlignment="Center"/>
                            </Grid>

                            <atom:ListBox x:Name="RecentSessionsList"
                                          Grid.Row="1"
                                          Classes="recent-session-list"
                                          Margin="0,16,0,0"
                                          HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding RecentSessions}"
                                          SelectedItem="{Binding SelectedRecentSession, Mode=TwoWay}"
                                          SelectionMode="Single"
                                          SizeType="Middle"
                                          IsShowSelectedIndicator="False"
                                          DoubleTapped="OnRecentSessionsDoubleTapped"
                                          KeyDown="OnRecentSessionsKeyDown">
                                <atom:ListBox.ItemTemplate>
                                    <DataTemplate DataType="vm:RecentSessionItemViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto,118,Auto"
                                              ColumnSpacing="12"
                                              MinHeight="44">
                                            <atom:IconPresenter Grid.Column="0"
                                                                Icon="{Binding Icon}"
                                                                Width="18"
                                                                Height="18"
                                                                IconBrush="{atom:SharedTokenResource ColorPrimary}"
                                                                VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1"
                                                        Spacing="2"
                                                        VerticalAlignment="Center">
                                                <atom:TextBlock Text="{Binding Name}"
                                                                FontSize="14"
                                                                FontWeight="SemiBold"
                                                                TextTrimming="CharacterEllipsis"
                                                                Foreground="{atom:SharedTokenResource ColorText}"/>
                                                <atom:TextBlock Text="{Binding Endpoint}"
                                                                FontSize="11"
                                                                TextTrimming="CharacterEllipsis"
                                                                Foreground="{atom:SharedTokenResource ColorTextTertiary}"/>
                                            </StackPanel>
                                            <atom:Tag Grid.Column="2"
                                                      Text="{Binding ProtocolText}"
                                                      TagColor="blue"
                                                      VerticalAlignment="Center"/>
                                            <atom:TextBlock Grid.Column="3"
                                                            Text="{Binding ConnectedText}"
                                                            FontSize="11"
                                                            TextAlignment="Right"
                                                            TextTrimming="CharacterEllipsis"
                                                            VerticalAlignment="Center"
                                                            Foreground="{atom:SharedTokenResource ColorTextTertiary}"/>
                                            <atom:Button Grid.Column="4"
                                                         Width="30"
                                                         Height="30"
                                                         Padding="0"
                                                         ButtonType="Text"
                                                         Shape="Circle"
                                                         Icon="{antdicons:AntDesignIconProvider Kind=LoginOutlined}"
                                                         Command="{Binding $parent[Window].DataContext.ConnectRecentSessionCommand, x:CompileBindings=False}"
                                                         CommandParameter="{Binding}"
                                                         atom:ToolTip.Tip="{Binding $parent[Window].DataContext.ConnectRecentSessionText, x:CompileBindings=False}"
                                                         VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </atom:ListBox.ItemTemplate>
                            </atom:ListBox>

                            <Border Grid.Row="2"
                                    Margin="0,16,0,0"
                                    Padding="0,16,0,0"
                                    BorderBrush="{atom:SharedTokenResource ColorSplit}"
                                    BorderThickness="0,1,0,0">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <atom:Button Content="{Binding WelcomeNewSessionText}"
                                                     Icon="{antdicons:AntDesignIconProvider Kind=PlusOutlined}"
                                                     Command="{Binding NewSessionCommand}"
                                                     ButtonType="Primary"/>
                                        <atom:Button Content="{Binding WelcomeSessionManagerText}"
                                                     Icon="{antdicons:AntDesignIconProvider Kind=UnorderedListOutlined}"
                                                     Command="{Binding ShowSessionManagerCommand}"
                                                     ButtonType="Default"/>
                                    </StackPanel>
                                    <atom:TextBlock Grid.Column="2"
                                                    Text="{Binding WelcomeBuiltWithAtomUiText}"
                                                    FontSize="11"
                                                    VerticalAlignment="Center"
                                                    Foreground="{atom:SharedTokenResource ColorTextQuaternary}"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 尚无最近记录时保留原欢迎内容 -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12"
                                    IsVisible="{Binding !HasRecentSessions}">
                            <atom:TextBlock Text="CxShell"
                                            FontSize="32"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center"
                                            Foreground="{atom:SharedTokenResource ColorText}"/>
                            <atom:TextBlock Text="{Binding WelcomeSelectSessionText}"
                                            HorizontalAlignment="Center"
                                            Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                            <atom:TextBlock Text="{Binding WelcomeBuiltWithAtomUiText}"
                                            HorizontalAlignment="Center"
                                            Foreground="{atom:SharedTokenResource ColorTextQuaternary}"
                                            FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <!-- 有标签时显示多标签布局 -->
                    <Grid IsVisible="{Binding HasTabs}"
                          RowDefinitions="Auto,*">
                        <!-- Tab 标题栏 -->
                        <Border Grid.Row="0"
                                IsVisible="{Binding IsMainTabHeaderVisible}"
                                Background="{atom:SharedTokenResource ColorBgLayout}"
                                BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}" BorderThickness="0,0,0,1">
                            <atom:TabStrip ItemsSource="{Binding Tabs}"
                                           Classes="session-tab-strip"
                                           SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                                           ItemTemplate="{StaticResource TabHeaderTemplate}"
                                           IsTabReorderEnabled="True"
                                           TabActivationTrigger="PointerReleased"
                                           IsTabClosable="True"
                                           IsTabAutoHideCloseButton="False"
                                           IsMotionEnabled="False"
                                           SizeType="Small"
                                           HeaderStartEdgePadding="4"
                                           HeaderEndEdgePadding="4"
                                           BorderThickness="0"
                                           Closing="OnTabStripClosing"/>
                        </Border>
                        <!-- 当前 Tab 的终端内容 -->
                        <Grid Grid.Row="1"
                              IsVisible="{Binding IsSingleTabContentVisible}">
                            <Grid IsVisible="{Binding $parent[Window].DataContext.IsSelectedTerminalSession, x:CompileBindings=False}"
                                  RowDefinitions="Auto,*">
                                <Border Grid.Row="0"
                                        IsVisible="{Binding SelectedTab.IsKeyboardBroadcastBarVisible}"
                                        Background="#FFFBE6"
                                        BorderBrush="#FFE58F"
                                        BorderThickness="0,0,0,1"
                                        Padding="10,4">
                                    <DockPanel LastChildFill="True">
                                        <atom:ToggleSwitch DockPanel.Dock="Right"
                                                           SizeType="Small"
                                                           IsChecked="{Binding SelectedTab.IsKeyboardBroadcastEnabled, Mode=TwoWay}"
                                                           ToolTip.Tip="{Binding SelectedTab.KeyboardBroadcastReceiveText}"
                                                           VerticalAlignment="Center"/>
                                        <atom:TextBlock Text="{Binding SelectedTab.KeyboardBroadcastStatusText}"
                                                        Foreground="#874D00"
                                                        FontSize="12"
                                                        VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <views:TerminalView x:Name="ActiveTerminalView"
                                                    Grid.Row="1"
                                                    DataContext="{Binding SelectedTab.Terminal, x:CompileBindings=False}"/>
                            </Grid>
                            <views:VncView DataContext="{Binding SelectedTab.Vnc, x:CompileBindings=False}"
                                           IsVisible="{Binding $parent[Window].DataContext.IsSelectedVncSession, x:CompileBindings=False}"/>
                            <views:RdpView DataContext="{Binding SelectedTab.Rdp, x:CompileBindings=False}"
                                           IsVisible="{Binding $parent[Window].DataContext.IsSelectedRdpSession, x:CompileBindings=False}"/>
                            <views:SftpPanelView DataContext="{Binding SelectedTab.FileTransfer, x:CompileBindings=False}"
                                                 IsVisible="{Binding $parent[Window].DataContext.IsSelectedFileTransferSession, x:CompileBindings=False}"/>
                        </Grid>

                        <!-- 多标签排列内容 -->
                        <Grid Grid.Row="1"
                              Background="{atom:SharedTokenResource ColorBgLayout}"
                              IsVisible="{Binding IsArrangedTabsVisible}">
                            <ItemsControl ItemsSource="{Binding TabGroups}"
                                          ItemTemplate="{StaticResource ArrangedTabPaneTemplate}"
                                          IsVisible="{Binding IsVerticalTabArrangement}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:ResizableStackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding TabGroups}"
                                          ItemTemplate="{StaticResource ArrangedTabPaneTemplate}"
                                          IsVisible="{Binding IsHorizontalTabArrangement}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:ResizableStackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding TileRows}"
                                          IsVisible="{Binding IsTileTabArrangement}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:ResizableStackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:TileTabGroupRowViewModel">
                                        <ItemsControl ItemsSource="{Binding Groups}"
                                                      ItemTemplate="{StaticResource ArrangedTabPaneTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <controls:ResizableStackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <Grid Grid.RowSpan="2"
                              IsVisible="{Binding IsTerminalFullScreen}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Top"
                              Height="44"
                              Background="Transparent"
                              PointerEntered="FullScreenHintArea_OnPointerEntered"
                              PointerExited="FullScreenHintArea_OnPointerExited">
                            <Border Height="3"
                                    Width="180"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Background="#64D8FF"
                                    BoxShadow="0 0 12 0 #9964D8FF"/>
                            <Border IsVisible="{Binding IsFullScreenHintVisible}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Margin="0,8,0,0"
                                    Padding="14,6"
                                    CornerRadius="6"
                                    Background="#CC1F2933"
                                    BorderBrush="#4464D8FF"
                                    BorderThickness="1">
                                <atom:TextBlock Text="{Binding FullScreenEscBackText}"
                                                Foreground="White"
                                                FontSize="13"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Col 2: 右侧分割线 + 监控面板（整体隐藏时不占宽度，Terminal 自动扩展） -->
                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            IsVisible="{Binding IsMonitorPanelVisible}">
                    <GridSplitter Width="3" HorizontalAlignment="Left"
                                  Background="{atom:SharedTokenResource ColorSplit}"/>
                    <views:ServerMonitorView DataContext="{Binding Monitor, x:CompileBindings=False}"
                                             Width="280"
                                             IsPanelCloseButtonVisible="True"
                                             PanelCloseCommand="{Binding $parent[Window].DataContext.ToggleMonitorCommand, x:CompileBindings=False}"/>
                </StackPanel>
                <Border Grid.Column="4"
                        x:Name="AgentSplitterHandle"
                        IsVisible="{Binding IsAgentPanelHostVisible}"
                        HorizontalAlignment="Stretch"
                        Background="{atom:SharedTokenResource ColorSplit}"
                        Cursor="SizeWestEast"
                        PointerPressed="OnAgentSplitterPointerPressed"
                        PointerMoved="OnAgentSplitterPointerMoved"
                        PointerReleased="OnAgentSplitterPointerReleased"/>
                <views:AgentPanelView Grid.Column="5"
                                      x:Name="AgentPanelHost"
                                      HorizontalAlignment="Stretch"
                                      IsVisible="False"
                                      DataContext="{Binding AgentPanel, x:CompileBindings=False}"/>
            </Grid>

        </Grid>
        <Grid Grid.RowSpan="4"
              ZIndex="300"
              IsVisible="{Binding CommandPalette.IsOpen}">
            <Border Background="#66000000"
                    PointerPressed="OnCommandPaletteBackdropPressed"/>
            <views:CommandPaletteView DataContext="{Binding CommandPalette}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Top"
                                      Margin="0,72,0,0"/>
        </Grid>
    </Grid>
</atom:Window>
