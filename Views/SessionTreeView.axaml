<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:vm="using:CxShell.ViewModels"
             x:Class="CxShell.Views.SessionTreeView"
             x:DataType="vm:SessionTreeViewModel"
             Background="{atom:SharedTokenResource ColorBgLayout}">
    <Grid>
        <Grid Width="760"
              HorizontalAlignment="Center"
              VerticalAlignment="Stretch"
              Margin="0,20,0,16"
              RowDefinitions="Auto,12,*">
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8">
                    <atom:Button x:Name="NewSessionBtn"
                                 Icon="{antdicons:AntDesignIconProvider Kind=PlusOutlined}"
                                 atom:ToolTip.Tip="{Binding NewText}"
                                 atom:ToolTip.Placement="Bottom"
                                 atom:ToolTip.ShowOnDisabled="True"/>
                    <atom:Button x:Name="ImportSessionBtn"
                                 Icon="{antdicons:AntDesignIconProvider Kind=ImportOutlined}"
                                 atom:ToolTip.Tip="{Binding ImportText}"
                                 atom:ToolTip.Placement="Bottom"
                                 atom:ToolTip.ShowOnDisabled="True"/>
                    <atom:Button x:Name="ExportSessionBtn"
                                 Icon="{antdicons:AntDesignIconProvider Kind=ExportOutlined}"
                                 IsEnabled="{Binding CanExportSelectedSessions}"
                                 atom:ToolTip.Tip="{Binding ExportText}"
                                 atom:ToolTip.Placement="Bottom"
                                 atom:ToolTip.ShowOnDisabled="True"/>
                </StackPanel>
                <atom:SearchEdit Grid.Column="1"
                                 Width="320"
                                 Margin="12,0,0,0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Text="{Binding SessionSearchText, Mode=TwoWay}"
                                 PlaceholderText="{Binding SearchPlaceholderText}"
                                 IsAllowClear="True"/>
            </Grid>

            <atom:DataGrid x:Name="SessionTree"
                                         x:CompileBindings="False"
                           Grid.Row="2"
                           Margin="0,8,0,16"
                           VerticalAlignment="Stretch"
                           AutoGenerateColumns="False"
                           IsReadOnly="True"
                           SelectionMode="Extended"
                           SizeType="Middle"
                           GridLinesVisibility="Horizontal"
                           CanUserResizeColumns="True"
                           CanUserSortColumns="True"
                           CanUserReorderRows="True"
                           >
                <atom:DataGrid.Columns>
                    <atom:DataGridRowReorderColumn Width="32"/>
                    <atom:DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="170"/>
                    <atom:DataGridTextColumn Header="主机" Binding="{Binding Host}" Width="215"/>
                    <atom:DataGridTextColumn Header="用户名" Binding="{Binding Username}" Width="140"/>
                    <atom:DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="92"/>
                    <atom:DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="92"/>
                </atom:DataGrid.Columns>
            </atom:DataGrid>
        </Grid>
    </Grid>
</UserControl>
