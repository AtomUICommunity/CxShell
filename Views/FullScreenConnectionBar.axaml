<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:views="using:CxShell.Views"
             x:Class="CxShell.Views.FullScreenConnectionBar"
             HorizontalAlignment="Center"
             VerticalAlignment="Top"
             Margin="0,6,0,0"
             IsHitTestVisible="False"
             Opacity="0"
             Focusable="False"
             Cursor="Arrow">
    <UserControl.Transitions>
        <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.13"/>
        </Transitions>
    </UserControl.Transitions>
    <!-- Floating connection bar for full screen. Kept visually close to the
         mstsc bar: pin, link quality, endpoint, then the window controls. -->
    <Border x:Name="BarRoot"
            Height="34"
            MinWidth="380"
            CornerRadius="8"
            Padding="5,0"
            Background="{atom:SharedTokenResource ColorBgElevated}"
            BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
            BorderThickness="1"
            BoxShadow="0 6 18 0 #40000000">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              VerticalAlignment="Stretch">
            <!-- Two pin buttons, only one visible: an outline pushpin while the
                 bar auto-hides, a filled pushpin while it is pinned. Shape
                 change reads far better than the old opacity change. -->
            <Panel Grid.Column="0"
                   Width="28"
                   Height="26"
                   VerticalAlignment="Center">
                <atom:Button x:Name="PinButton"
                             Width="28"
                             Height="26"
                             Padding="0"
                             ButtonType="Text"
                             Focusable="False"
                             Icon="{antdicons:AntDesignIconProvider Kind=PushpinOutlined}"
                             Click="OnPinClick"/>

                <atom:Button x:Name="PinnedButton"
                             Width="28"
                             Height="26"
                             Padding="0"
                             IsVisible="False"
                             ButtonType="Text"
                             Focusable="False"
                             Icon="{antdicons:AntDesignIconProvider Kind=PushpinFilled}"
                             Click="OnPinClick"/>
            </Panel>

            <Panel x:Name="SignalPanel"
                   Grid.Column="1"
                   Width="24"
                   Height="16"
                   Margin="2,0,4,0"
                   VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"
                            Spacing="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom">
                    <Rectangle x:Name="SignalBar1" Width="3" Height="4" RadiusX="1" RadiusY="1"
                               Fill="{atom:SharedTokenResource ColorSuccess}"/>
                    <Rectangle x:Name="SignalBar2" Width="3" Height="7" RadiusX="1" RadiusY="1"
                               Fill="{atom:SharedTokenResource ColorSuccess}"/>
                    <Rectangle x:Name="SignalBar3" Width="3" Height="10" RadiusX="1" RadiusY="1"
                               Fill="{atom:SharedTokenResource ColorSuccess}"/>
                    <Rectangle x:Name="SignalBar4" Width="3" Height="13" RadiusX="1" RadiusY="1"
                               Fill="{atom:SharedTokenResource ColorSuccess}"/>
                </StackPanel>
            </Panel>

            <Grid Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Name="EndpointText"
                           Margin="6,0"
                           FontSize="12"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{atom:SharedTokenResource ColorText}"/>

                <ScrollViewer x:Name="TabSwitcherScroll"
                              IsVisible="False"
                              MaxWidth="520"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              VerticalAlignment="Center"
                              Margin="4,0">
                    <ItemsControl x:Name="FloatingTabItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="views:RdpWorkspaceTabItem">
                                <Border Height="24"
                                        Padding="8,0,4,0"
                                        CornerRadius="5"
                                        Background="{atom:SharedTokenResource ColorFillTertiary}"
                                        Cursor="Hand"
                                        PointerPressed="OnTabItemPointerPressed">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="4"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{atom:SharedTokenResource ColorText}"
                                                   FontSize="12"
                                                   FontWeight="{Binding TitleFontWeight}"
                                                   MaxWidth="140"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <Button Width="16"
                                                Height="16"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="3"
                                                Focusable="False"
                                                VerticalAlignment="Center"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                ToolTip.Tip="关闭标签页"
                                                Click="OnCloseTabClick">
                                            <atom:IconPresenter Icon="{antdicons:AntDesignIconProvider Kind=CloseOutlined}"
                                                                Width="10"
                                                                Height="10"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <atom:Button x:Name="MultiMonitorButton"
                         Grid.Column="3"
                         IsVisible="False"
                         Height="26"
                         Padding="6,0"
                         ButtonType="Text"
                         Focusable="False"
                         VerticalAlignment="Center"
                         Icon="{antdicons:AntDesignIconProvider Kind=DesktopOutlined}"
                         Content="多显示器"
                         Click="OnMultiMonitorClick"/>

            <atom:Button x:Name="TaskbarModeButton"
                         Grid.Column="4"
                         IsVisible="False"
                         Height="26"
                         Padding="6,0"
                         ButtonType="Text"
                         Focusable="False"
                         VerticalAlignment="Center"
                         Content="保留任务栏"
                         Click="OnTaskbarModeClick"/>

            <Border x:Name="ExtraActionsDivider"
                    Grid.Column="5"
                    IsVisible="False"
                    Width="1"
                    Height="14"
                    Margin="2,0"
                    VerticalAlignment="Center"
                    Background="{atom:SharedTokenResource ColorSplit}"/>

            <atom:Button x:Name="MinimizeButton"
                         Grid.Column="6"
                         Width="28"
                         Height="26"
                         Padding="0"
                         ButtonType="Text"
                         Focusable="False"
                         VerticalAlignment="Center"
                         Icon="{antdicons:AntDesignIconProvider Kind=MinusOutlined}"
                         Click="OnMinimizeClick"/>

            <!-- Leaving full screen is the only full-screen action the bar
                 offers: four arrows pointing inward, the mirror of the glyph
                 the caption button uses to enter. There is deliberately no
                 matching "enter full screen" button here - the caption button
                 already carries that, and two identical-looking arrows next to
                 the close button only made the bar ambiguous. -->
            <atom:Button x:Name="RestoreButton"
                         Grid.Column="7"
                         Width="28"
                         Height="26"
                         Padding="0"
                         ButtonType="Text"
                         Focusable="False"
                         VerticalAlignment="Center"
                         Icon="{antdicons:AntDesignIconProvider Kind=SwitcherOutlined}"
                         Click="OnRestoreClick"/>

            <atom:Button x:Name="FullScreenButton"
                         Grid.Column="8"
                         IsVisible="False"
                         Width="28"
                         Height="26"
                         Padding="0"
                         ButtonType="Text"
                         Focusable="False"
                         VerticalAlignment="Center"
                         Icon="{antdicons:AntDesignIconProvider Kind=FullscreenOutlined}"
                         Click="OnFullScreenClick"/>

            <atom:Button x:Name="CloseButton"
                         Grid.Column="9"
                         Width="28"
                         Height="26"
                         Padding="0"
                         ButtonType="Text"
                         Focusable="False"
                         VerticalAlignment="Center"
                         Icon="{antdicons:AntDesignIconProvider Kind=CloseOutlined}"
                         Click="OnCloseClick"/>
        </Grid>
    </Border>
</UserControl>
