<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:vm="using:CxShell.ViewModels"
             x:Class="CxShell.Views.AboutPage"
             x:DataType="vm:SettingsCenterViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="26"
                    Margin="0,2,12,18">
            <Grid ColumnDefinitions="88,*"
                  ColumnSpacing="16">
                <Image Grid.Column="0"
                       Width="48"
                       Height="48"
                       Margin="12,12,0,0"
                       Source="/Assets/CxShellLogo.png"
                       Stretch="Uniform"
                       VerticalAlignment="Top"/>

                <StackPanel Grid.Column="1"
                            Spacing="7"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding AboutAppNameText}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{atom:SharedTokenResource ColorText}"/>
                    <StackPanel Orientation="Horizontal"
                                Spacing="10">
                        <TextBlock Text="{Binding AboutVersionBadgeText}"
                                   FontFamily="Cascadia Mono,Consolas,monospace"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{atom:SharedTokenResource ColorPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel Spacing="6">
                <TextBlock Text="{Binding AboutContentText}"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Foreground="{atom:SharedTokenResource ColorText}"/>
                <TextBlock Text="{Binding AboutBuiltWithText}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
            </StackPanel>

            <StackPanel Spacing="9">
                <TextBlock Text="{Binding AboutSystemInfoText}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{atom:SharedTokenResource ColorText}"/>
                <Border Background="{atom:SharedTokenResource ColorBgLayout}"
                        BorderBrush="{atom:SharedTokenResource ColorSplit}"
                        BorderThickness="1"
                        CornerRadius="5">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                        <Border Grid.Row="0"
                                Padding="14,11"
                                BorderBrush="{atom:SharedTokenResource ColorSplit}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="180,*"
                                  ColumnSpacing="18">
                                <TextBlock Text="{Binding AboutFrameworkLabelText}"
                                           Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding AboutFrameworkValueText}"
                                           FontFamily="Cascadia Mono,Consolas,monospace"
                                           Foreground="{atom:SharedTokenResource ColorText}"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1"
                                Padding="14,11"
                                BorderBrush="{atom:SharedTokenResource ColorSplit}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="180,*"
                                  ColumnSpacing="18">
                                <TextBlock Text="{Binding AboutAtomUiLabelText}"
                                           Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding AboutAtomUiValueText}"
                                           FontFamily="Cascadia Mono,Consolas,monospace"
                                           Foreground="{atom:SharedTokenResource ColorText}"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2"
                                Padding="14,11"
                                BorderBrush="{atom:SharedTokenResource ColorSplit}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="180,*"
                                  ColumnSpacing="18">
                                <TextBlock Text="{Binding AboutRuntimeLabelText}"
                                           Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding AboutRuntimeValueText}"
                                           FontFamily="Cascadia Mono,Consolas,monospace"
                                           Foreground="{atom:SharedTokenResource ColorText}"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="3"
                                Padding="14,11"
                                BorderBrush="{atom:SharedTokenResource ColorSplit}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="180,*"
                                  ColumnSpacing="18">
                                <TextBlock Text="{Binding AboutSshLabelText}"
                                           Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding AboutSshValueText}"
                                           FontFamily="Cascadia Mono,Consolas,monospace"
                                           Foreground="{atom:SharedTokenResource ColorText}"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="4"
                                Padding="14,11"
                                BorderBrush="{atom:SharedTokenResource ColorSplit}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="180,*"
                                  ColumnSpacing="18">
                                <TextBlock Text="{Binding AboutOperatingSystemLabelText}"
                                           Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding AboutOperatingSystemValueText}"
                                           TextWrapping="Wrap"
                                           FontFamily="Cascadia Mono,Consolas,monospace"
                                           Foreground="{atom:SharedTokenResource ColorText}"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="5"
                                Padding="14,11">
                            <Grid ColumnDefinitions="180,*"
                                  ColumnSpacing="18">
                                <TextBlock Text="{Binding AboutConfigurationLabelText}"
                                           Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding AboutConfigurationValueText}"
                                           TextWrapping="Wrap"
                                           FontFamily="Cascadia Mono,Consolas,monospace"
                                           Foreground="{atom:SharedTokenResource ColorText}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <Border Background="{atom:SharedTokenResource ColorBgLayout}"
                    BorderBrush="{atom:SharedTokenResource ColorSplit}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="14,12">
                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="18"
                      RowSpacing="8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding AboutUpdateText}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{atom:SharedTokenResource ColorText}"/>
                        <TextBlock Text="{Binding AboutUpdateDescriptionText}"
                                   TextWrapping="Wrap"
                                   Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                    </StackPanel>
                    <atom:Button Grid.Column="1"
                                 Content="{Binding CheckForUpdatesText}"
                                 Icon="{antdicons:AntDesignIconProvider Kind=CloudSyncOutlined}"
                                 Command="{Binding CheckForUpdatesCommand}"
                                 ButtonType="Primary"
                                 VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="{Binding UpdateCurrentVersionText}"
                               FontSize="12"
                               Foreground="{atom:SharedTokenResource ColorTextTertiary}"/>
                </Grid>
            </Border>

            <StackPanel Spacing="9">
                <TextBlock Text="{Binding AboutOpenSourceText}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{atom:SharedTokenResource ColorText}"/>
                <TextBlock Text="{Binding AboutOpenSourceDescriptionText}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                <Border Background="{atom:SharedTokenResource ColorBgLayout}"
                        BorderBrush="{atom:SharedTokenResource ColorSplit}"
                        BorderThickness="1"
                        CornerRadius="5">
                    <ItemsControl ItemsSource="{Binding AboutDependencies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AboutDependencyViewModel">
                                <Border Padding="14,10"
                                        BorderBrush="{atom:SharedTokenResource ColorSplit}"
                                        BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="16">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="10">
                                            <atom:IconPresenter Icon="{antdicons:AntDesignIconProvider Kind=CodeOutlined}"
                                                                Width="16"
                                                                Height="16"
                                                                IconBrush="{atom:SharedTokenResource ColorPrimary}"
                                                                VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{atom:SharedTokenResource ColorText}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding License}"
                                                   Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <StackPanel Spacing="9">
                <TextBlock Text="{Binding AboutSupportText}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{atom:SharedTokenResource ColorText}"/>
                <TextBlock Text="{Binding AboutSupportDescriptionText}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                <StackPanel Orientation="Horizontal"
                            Spacing="10">
                    <atom:Button Content="{Binding AboutOpenGitHubText}"
                                 Icon="{antdicons:AntDesignIconProvider Kind=GithubOutlined}"
                                 ButtonType="Default"
                                 Click="OnGitHubClick"/>
                </StackPanel>
                <TextBlock Text="{Binding AboutGitHubUrlText}"
                           FontFamily="Cascadia Mono,Consolas,monospace"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{atom:SharedTokenResource ColorTextTertiary}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
