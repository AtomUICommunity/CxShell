<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:controls="clr-namespace:CxShell.Controls"
             xmlns:vm="clr-namespace:CxShell.ViewModels"
             xmlns:services="using:CxShell.Services"
             x:Class="CxShell.Views.RdpView"
             x:DataType="vm:RdpViewModel"
             Focusable="True"
             Cursor="Arrow"
             Background="{atom:SharedTokenResource ColorBgLayout}">
    <Grid>
        <Border x:Name="RdpViewport"
                Background="#111111"
                Cursor="Arrow"
                ClipToBounds="True"
                DragDrop.AllowDrop="True"
                SizeChanged="OnViewportSizeChanged">
            <Grid>
                <Image x:Name="FramebufferImage"
                       Source="{Binding Framebuffer}"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Cursor="Arrow"
                       Focusable="True"
                       PointerMoved="OnFramebufferPointerMoved"
                       PointerPressed="OnFramebufferPointerPressed"
                       PointerReleased="OnFramebufferPointerReleased"
                       PointerWheelChanged="OnFramebufferPointerWheelChanged"/>
                <controls:RdpSliceSurface x:Name="PrimarySliceSurface"
                                          IsVisible="False"
                                          Focusable="True"
                                          PointerMoved="OnFramebufferPointerMoved"
                                          PointerPressed="OnFramebufferPointerPressed"
                                          PointerReleased="OnFramebufferPointerReleased"
                                          PointerWheelChanged="OnFramebufferPointerWheelChanged"/>
            </Grid>
        </Border>

        <Popup x:Name="MultiMonitorPopup"
               Placement="Bottom"
               IsLightDismissEnabled="True">
            <Border Padding="12,10"
                    CornerRadius="8"
                    Background="#F218202A"
                    BorderBrush="#5564D8FF"
                    BorderThickness="1"
                    BoxShadow="0 6 18 0 #77000000"
                    MinWidth="260">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding [Rdp.MultiMonitorPrompt], Source={x:Static services:LocalizationService.Shared}}"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                    <StackPanel x:Name="MonitorCheckboxList" Spacing="4"/>
                    <Button x:Name="AddVirtualMonitorButton"
                            Content="{Binding [Rdp.AddVirtualMonitor], Source={x:Static services:LocalizationService.Shared}}"
                            Foreground="White"
                            Background="#22FFFFFF"
                            BorderBrush="#40FFFFFF"
                            BorderThickness="1"
                            CornerRadius="4"
                            FontSize="11"
                            Padding="8,4"
                            HorizontalAlignment="Left"
                            Click="OnAddVirtualMonitorClick"/>
                    <Border Height="1" Background="#33FFFFFF" Margin="0,4"/>
                    <TextBlock Text="{Binding [Rdp.UltrawideSection], Source={x:Static services:LocalizationService.Shared}}"
                               Foreground="#CCFFFFFF"
                               FontSize="11"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="ModeStandardButton"
                                Content="{Binding [Rdp.UltrawideStandard], Source={x:Static services:LocalizationService.Shared}}"
                                Foreground="White"
                                Background="#22FFFFFF"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                CornerRadius="4"
                                FontSize="11"
                                Padding="8,4"
                                Click="OnUltrawideModeStandardClick"/>
                        <Button x:Name="ModeSplitDualButton"
                                Content="{Binding [Rdp.UltrawideSplitDual], Source={x:Static services:LocalizationService.Shared}}"
                                Foreground="White"
                                Background="#22FFFFFF"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                CornerRadius="4"
                                FontSize="11"
                                Padding="8,4"
                                Click="OnUltrawideModeSplitDualClick"/>
                        <Button x:Name="ModeMergeUltrawideButton"
                                Content="{Binding [Rdp.UltrawideMergeUltrawide], Source={x:Static services:LocalizationService.Shared}}"
                                Foreground="White"
                                Background="#22FFFFFF"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                CornerRadius="4"
                                FontSize="11"
                                Padding="8,4"
                                Click="OnUltrawideModeMergeUltrawideClick"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
        <Border IsVisible="{Binding IsDesktopLoading}"
                Background="#FF111111"
                Cursor="Arrow">
            <StackPanel Spacing="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="420">
                <TextBlock Text="{Binding DesktopLoadingText}"
                           FontSize="15"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{atom:SharedTokenResource ColorText}"/>
                <ProgressBar IsIndeterminate="True"
                             Height="3"
                             MinWidth="240"
                             Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <Border IsVisible="{Binding IsConnectionOverlayVisible}"
                Background="#66000000"
                Cursor="Arrow">
            <Border Background="{atom:SharedTokenResource ColorBgContainer}"
                    BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="28,22"
                    MaxWidth="380"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 24 0 #40000000">
                <StackPanel Spacing="14" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ReconnectStatusText}"
                               FontSize="14"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{atom:SharedTokenResource ColorText}"/>
                    <ProgressBar IsIndeterminate="True"
                                 Height="3"
                                 MinWidth="200"
                                 IsVisible="{Binding IsReconnecting}"/>
                    <atom:Button ButtonType="Primary"
                                 Content="{Binding ReconnectLabel}"
                                 HorizontalAlignment="Center"
                                 Command="{Binding ReconnectCommand}"
                                 IsVisible="{Binding IsConnectionLost}"/>
                    <atom:Button ButtonType="Default"
                                 Content="{Binding CancelRetryLabel}"
                                 HorizontalAlignment="Center"
                                 Command="{Binding CancelReconnectCommand}"
                                 IsVisible="{Binding IsCancelRetryVisible}"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
